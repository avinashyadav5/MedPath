# Neon / Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq API key used for AI diagnosis + triage nurse
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Optional: override the Groq model (defaults to openai/gpt-oss-120b with fallback to openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b

# Secret used to sign session JWTs (change this!)
JWT_SECRET=change-me-to-a-long-random-string

# Where the Vite client runs, used for CORS + cookie origin
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development
