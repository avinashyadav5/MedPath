# Neon / Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Groq API key used for AI diagnosis + triage nurse
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Optional: override the Groq model (defaults to llama3-70b-8192 which works on free tier)
# Use llama-3.3-70b-versatile if your plan has access to it
# GROQ_MODEL=llama-3.3-70b-versatile

# Secret used to sign session JWTs (change this!)
JWT_SECRET=change-me-to-a-long-random-string

# Where the Vite client runs, used for CORS + cookie origin
CLIENT_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development
